# Copie para .env e ajuste se necessario
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sep_dev
DB_USER=sep
DB_PASSWORD=sep

APP_JWT_SECRET=replace-this-in-production-with-32-chars-min-secure-random-key
APP_JWT_EXPIRATION=3600

APP_CORS_ORIGINS=http://localhost:4200,http://localhost:8100

# Regex Java (NAO CIDR) das origens de proxy confiaveis, lida por
# server.tomcat.remoteip.internal-proxies. Vazio = nao confia em ninguem, que e o default
# seguro enquanto nao ha balanceador. OBRIGATORIA na Fase 5: sem ela o app sobe atras do
# balanceador e degrada em silencio (rate limit por IP vira global, HSTS some, OpenAPI
# anuncia a origem interna) — o boot em prod passa a falhar por isso, de proposito.
# Um CIDR como 10.0.0.0/8 NAO casa nada: e regex, nao notacao de rede.
# APP_TRUSTED_PROXIES=10\.0\.\d{1,3}\.\d{1,3}
