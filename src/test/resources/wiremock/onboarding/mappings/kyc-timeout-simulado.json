{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/verifications",
    "headers": {
      "X-Simular": {
        "equalTo": "timeout"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "verification_id": "kyc-local-timeout",
      "status": "PROCESSING"
    },
    "fixedDelayMilliseconds": 35000
  }
}
